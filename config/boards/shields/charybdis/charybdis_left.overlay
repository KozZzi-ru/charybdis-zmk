#include "charybdis.dtsi"

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&kscan0 {
    col-gpios = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};

&pmw_listener {
    status = "okay";

    // Базовый слой: без инверсий (было 2× с CONFIG, теперь 0× = без инверсии)
    // Сохраняет текущее поведение: X и Y без инверсии
    input-processors = <
        &zip_temp_layer 3 2000  // увеличен timeout для стабильности
    >;

    // Scroll слой: только Y инвертирован (было: CONFIG=1× Y + OVERLAY=1× X = 2× X и 1× Y)
    // Теперь: только OVERLAY=1× Y = 0× X и 1× Y
    // Сохраняет текущее поведение: X без инверсии, Y инвертирован
    scroller {
        layers = <3>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)  // изменено с X на Y
            &zip_xy_scaler 1 10
            &zip_scroll_scaler 2 1
            &zip_xy_to_scroll_mapper
        >;
    };

    // Snipe слой: без инверсий (было 2× с CONFIG, теперь 0× = без инверсии)
    // Сохраняет текущее поведение: X и Y без инверсии
    snipe {
        layers = <4>;
        input-processors = <
            &zip_xy_scaler 1 1  // убраны инверсии
        >;
    };
};
